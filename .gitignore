# dependencies
node_modules/

# next.js
.next/
out/

# build
tsconfig.tsbuildinfo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# env files
.env*.local

# package lock
package-lock.json

# taste-skill gate state: only the waivers are kept
.taste-skill/*
!.taste-skill/waivers.json

# Permission-gated client figures: local builds only, never committed until the client signs off
lib/content/*.private.ts

# Original photographs: kept locally like docs/brand; node scripts/images.mjs needs them to regenerate the committed renditions
assets/photos/

# Screenshot originals: kept locally like the photographs; their WebP renditions and lib/screenshots.json are committed
assets/screenshots/
